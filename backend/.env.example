# Google Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Standard-Modell (z. B. gemini-3.7-flash, gemini-3.8-flash, gemini-2.5-pro)
DEFAULT_MODEL=gemini-3.7-flash

# Server-Port
PORT=8000

# Optional: Google Jules API Key (falls Jules-Integration genutzt wird)
GOOGLE_JULES_API_KEY=your_jules_api_key_here

# LangSmith / LangChain Tracing (LangGraph Dev-Cycle)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=antigravity-graph
